{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "effortLevel": "high",
  "theme": "dark-ansi",
  "permissions": {
    "allow": [
      "Bash(sudo -c qemu:///system)",
      "Bash(sudo virsh -c qemu:///system destroy win11)",
      "Bash(sudo virsh -c qemu:///system list --all)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "$HOME/.local/bin/claude-status-hook start" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "$HOME/.local/bin/claude-status-hook prompt" } ] }
    ],
    "PreToolUse": [
      { "matcher": "", "hooks": [ { "type": "command", "command": "$HOME/.local/bin/claude-status-hook tool" } ] }
    ],
    "PostToolUse": [
      { "matcher": "", "hooks": [ { "type": "command", "command": "$HOME/.local/bin/claude-status-hook tool" } ] }
    ],
    "Notification": [
      { "matcher": "", "hooks": [ { "type": "command", "command": "$HOME/.local/bin/claude-status-hook notify" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "$HOME/.local/bin/claude-status-hook stop" } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "$HOME/.local/bin/claude-status-hook end" } ] }
    ]
  }
}

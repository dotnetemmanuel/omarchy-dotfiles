//      dMMMMMP dMP dMP dMMMMMP dMMMMb dMMMMMMP
//     dMP     dMP dMP dMP     dMP dMP   dMP
//    dMMMP   dMP dMP dMMMP   dMP dMP   dMP
//   dMP      YMvAP" dMP     dMP dMP   dMP
//  dMMMMMP    VP"  dMMMMMP dMP dMP   dMP
//
//      dMP dMP .aMMMb  dMMMMb  dMP dMMMMMP .aMMMb  dMMMMb
//     dMP dMP dMP"dMP dMP.dMP amr   .dMP" dMP"dMP dMP dMP
//    dMMMMMP dMP dMP dMMMMK" dMP  .dMP"  dMP dMP dMP dMP
//   dMP dMP dMP.aMP dMP"AMF dMP .dMP"   dMP.aMP dMP dMP
//  dMP dMP  VMMMP" dMP dMP dMP dMMMMMP  VMMMP" dMP dMP
//
//  Two bars sharing one set of modules (modules.jsonc):
//    "main"    - every output except the portrait DP-1
//    "compact" - DP-1 only, smaller and with now-playing moved to the centre

[
  {
    "name": "main",
    "output": "!DP-1",
    "include": ["/home/emmanuel/.config/waybar/modules.jsonc"],

    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "height": 30,

    "modules-left": ["group/left-pill", "custom/idle-lock"],
    "modules-center": [
      "custom/omarchy",
      "hyprland/workspaces",
      "clock",
      "custom/update",
      "custom/screenrecording-indicator"
    ],
    "modules-right": ["custom/mpris", "group/tray-expander"]
  },

  {
    "name": "compact",
    "output": ["DP-1"],
    "include": ["/home/emmanuel/.config/waybar/modules.jsonc"],

    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "height": 25,

    "modules-left": ["group/left-pill", "custom/idle-lock"],
    "modules-center": [
      "custom/omarchy",
      "hyprland/workspaces",
      "clock",
      "custom/update",
      "custom/screenrecording-indicator"
    ],
    "modules-right": ["custom/mpris", "group/tray-expander"],

    "custom/mpris": { "max-length": 22 },
    "tray": { "icon-size": 13, "spacing": 8 }
  }
]

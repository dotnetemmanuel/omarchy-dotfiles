# Embedded git repos (e.g. omarchy themes cloned from upstream)
# Commit the theme files themselves, but not nested .git/ directories
**/.git/

# Editor / OS noise
*.swp
*.swo
*~
.DS_Store

# Backups and rotated logs
*.bak
*.bak.*
*.old
*.orig

# Caches that sneak into config dirs
**/cache/
**/Cache/
**/.cache/
**/*.cache
**/mimeinfo.cache

# Runtime sockets / pids (e.g. cliamp, walker)
*.sock
*.sock.pid
*.pid

# Build / log artifacts
*.log
*.tmp

# Claude — extra paranoia: never commit credentials or session data even if
# something gets accidentally moved into the claude package later
.claude/.credentials.json
.claude/history.jsonl
.claude/sessions/
.claude/session-env/
.claude/projects/*/conversation*
.claude/projects/*/history*
# Only commit MEMORY.md (the index); keep individual memory files local
claude/.claude/projects/*/memory/*.md
!claude/.claude/projects/*/memory/MEMORY.md

# Zed auth token — file must stay on disk for Zed to work, but never commit it
zed/.config/zed/development_credentials

# herdr keeps live session state next to its config; only config.toml is ours
herdr/.config/herdr/session.json
herdr/.config/herdr/release-notes.json
herdr/.config/herdr/.plugins.lock

# Omarchy ships its themes — no need to back them up
omarchy/.config/omarchy/themes/
# current/theme/ is a copy of the selected theme; keep only theme.name
omarchy/.config/omarchy/current/theme/
omarchy/.config/omarchy/current/background

.fizzy.yaml
